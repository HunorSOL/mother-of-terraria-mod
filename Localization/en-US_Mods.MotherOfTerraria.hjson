Items: {
	PlaceholderSword: {
		DisplayName: Placeholder Sword
		Tooltip: Phase 0 test weapon. Will be removed before release.
	}

	HeavenlyTeleporter: {
		DisplayName: Heavenly Teleporter
		Tooltip:
			'''
			Opens a portal to the Heavens.
			Use it again in the Heavens to return home.
			'''
	}

	HeavensCrystal: {
		DisplayName: Heavens Crystal
		Tooltip: A crystal brimming with heavenly power.
	}

	DebugBossSummoner: {
		DisplayName: Debug Boss Summoner
		Tooltip:
			'''
			TESTING ONLY. Remove before release.
			Summons the Mother of Terraria right away (in the Heavens only).
			'''
	}

	DebugStageTester: {
		DisplayName: Debug Stage Tester
		Tooltip:
			'''
			TESTING ONLY. Remove before release.
			Hitting the Mother of Terraria with it drops her to the stage 2 health threshold.
			'''
	}

	DebugStageTwoSkipper: {
		DisplayName: Debug Stage Two Skipper
		Tooltip:
			'''
			TESTING ONLY. Remove before release.
			Hitting the Mother of Terraria with it starts stage 2 at once, skipping the crystals.
			'''
	}

	DebugStarterKit: {
		DisplayName: Debug Starter Kit
		Tooltip:
			'''
			TESTING ONLY. Remove before release.
			Gives a Celestial Sigil, a Copper Shortsword, a Heavenly Teleporter and 30 Heavens Crystals.
			'''
	}
}

